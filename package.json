{
  "name": "proofpay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ProofPay — Money moves when the promise is proven.",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "typecheck": "npm run typecheck --prefix backend",
    "eval": "npm run eval --prefix backend",
    "eval:local": "npm run eval --prefix backend -- --local",
    "check": "npm run typecheck && npm test && npm run build",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "mongo": "npm run mongo --prefix backend"
  }
}
