# ─── Server ────────────────────────────────────────────────────────────────
# 5050, not 5000: macOS runs AirPlay Receiver on 5000 and it answers with a 403.
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/proofpay
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/proofpay
MONGODB_URI=mongodb://127.0.0.1:27017/proofpay
# If no MongoDB is reachable, set this to true and the API boots an ephemeral
# local mongod (via mongodb-memory-server) so you can demo without installing one.
ALLOW_MEMORY_DB=true

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 (Google Cloud Console) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave this blank on a deployed host: it is derived from the service's own
# origin. Set it only when that derivation cannot work (a custom domain, or a
# platform that does not announce its URL). Whatever it resolves to must be
# registered in the Google Cloud Console verbatim, and the server prints it at
# boot so the two can be compared.
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# ─── Proof Engine ──────────────────────────────────────────────────────────
# One key, any of three providers. The provider is read from the key's own
# prefix, so pasting a key is enough:
#   sk-ant-…  → anthropic     sk-…  → openai     AIza… / AQ.…  → gemini
# Leave AI_API_KEY empty and the deterministic local engine runs instead — a
# real fallback, not a stub, and the interface labels which one answered.
AI_API_KEY=
# openai | anthropic | gemini | auto (default: read from the key prefix)
AI_PROVIDER=auto
# Optional. Blank uses each provider's default:
#   openai gpt-4.1-mini · anthropic claude-sonnet-5 · gemini gemini-3.6-flash
AI_MODEL=
# An OpenAI-compatible gateway, when the models are not the vendor's own.
#
# Resellers and self-hosted proxies (New API, LiteLLM, OpenRouter, and the like)
# speak OpenAI's wire format while serving somebody else's models — and they all
# issue keys starting "sk-", so the key cannot say where it belongs. Set this and
# the request goes here instead of to OpenAI, AI_MODEL names the model, and every
# reading is labelled with this host rather than with OpenAI.
#
#   AI_BASE_URL=https://tabitoken.com/v1
#   AI_MODEL=claude-opus-5
AI_BASE_URL=

# How long a model call may take. The two differ because they answer to
# different people: the first is a person's patience while a screen waits on a
# judgement, the second is a reading that happens in the background — nobody is
# waiting on it, so it is worth letting a slow provider finish rather than
# falling back to the deterministic engine.
# The ceiling on one answer. Every contract here is small — this exists to stop a
# runaway generation, not to describe an expected size. Lower it when an account
# is billed against the ceiling rather than the tokens actually produced, and is
# refused for asking too high even when the answer would have been short:
#   "You requested up to 16000 tokens, but can only afford 1598"
AI_MAX_TOKENS=16000

AI_TIMEOUT_MS=30000
AI_BACKGROUND_TIMEOUT_MS=90000

# How long to wait when the provider says it is busy (HTTP 503, or Anthropic's
# 529) rather than metered. A rate limit names the window to come back in; an
# overload does not, so this is the opening bid and it doubles each time the
# provider refuses again. Set it low only in tests — asking an overloaded model
# again immediately is how a busy provider gets scored as a stupid one.
AI_OVERLOAD_RETRY_MS=5000

# ─── Payments ──────────────────────────────────────────────────────────────
# demo | razorpay
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in the Razorpay dashboard beside the webhook URL, and NOT the API secret.
# Without it ProofPay only learns a payment succeeded if the payer's browser
# came back to say so — a closed tab or a lost connection leaves money captured
# against a promise that still reads as unfunded.
#   Endpoint: https://proofpay-cknb.onrender.com/api/webhooks/razorpay
#   Events:   payment.captured, payment.failed, payout.processed,
#             payout.failed, payout.reversed
RAZORPAY_WEBHOOK_SECRET=

# ─── Payouts (RazorpayX) ───────────────────────────────────────────────────
# Capturing a payment only moves money as far as your own Razorpay account.
# A payout is what carries it to the recipient's bank or UPI. RazorpayX is a
# separate product: it needs its own activation, KYC, a funded account and IP
# allowlisting — so the default here is a simulator that behaves the same way
# without moving money. Set PAYOUTS_ENABLED=false to skip the last mile entirely
# and record a release without a payout, which is what demo mode does.
PAYOUTS_ENABLED=false
# simulated | upi-intent | razorpayx
# "upi-intent" moves REAL money: it generates an NPCI deep link the payer settles
# from their own bank app, then records the UTR. No licence, no fees, no custody.
# "simulated" runs the real payout state machine (queued -> processing ->
# processed, plus failures and reversals) without moving money or needing
# RazorpayX. Every payout it produces is labelled simulated in the interface.
PAYOUT_PROVIDER=simulated
# How long the simulated rail takes to settle, so "in flight" is visible.
PAYOUT_SIM_SETTLE_MS=8000
# The RazorpayX account number money is sent FROM (not the recipient's).
RAZORPAYX_ACCOUNT_NUMBER=
# Only needed if RazorpayX issues separate keys; otherwise the RAZORPAY_ ones are used.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# IMPS (instant, 24/7, up to Rs 5 lakh) | NEFT | RTGS. UPI destinations always use UPI.
PAYOUT_MODE=IMPS

# ─── Email ─────────────────────────────────────────────────────────────────
# Two routes out, tried in this order. Neither set, ProofPay writes each message
# to the log instead of sending it — the feature works in development without
# credentials and you can still see exactly what would have gone out.
#
# 1. Brevo's HTTP API, over 443. REQUIRED ON A FREE RENDER INSTANCE: outbound
#    25, 465 and 587 are blocked there, so SMTP does not fail — it hangs until
#    it times out and the message silently never arrives. Brevo's free tier
#    verifies a single sender address, so a plain Gmail works with no domain.
#    MAIL_FROM must be that verified address.
BREVO_API_KEY=
#
# 2. SMTP, for local development and any host that allows it.
#    Gmail: smtp.gmail.com : 587, with an App Password (not your account
#    password), and MAIL_FROM must match SMTP_USER or Gmail rewrites the sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ProofPay <no-reply@proofpay.app>

# ─── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
