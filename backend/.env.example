# ─── Server ────────────────────────────────────────────────────────────────
# 5050, not 5000: macOS runs AirPlay Receiver on 5000 and it answers with a 403.
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/proofpay
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/proofpay
MONGODB_URI=mongodb://127.0.0.1:27017/proofpay
# If no MongoDB is reachable, set this to true and the API boots an ephemeral
# local mongod (via mongodb-memory-server) so you can demo without installing one.
ALLOW_MEMORY_DB=true

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 (Google Cloud Console) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# ─── Proof Engine ──────────────────────────────────────────────────────────
# One key, any of three providers. The provider is read from the key's own
# prefix, so pasting a key is enough:
#   sk-ant-…  → anthropic     sk-…  → openai     AIza… / AQ.…  → gemini
# Leave AI_API_KEY empty and the deterministic local engine runs instead — a
# real fallback, not a stub, and the interface labels which one answered.
AI_API_KEY=
# openai | anthropic | gemini | auto (default: read from the key prefix)
AI_PROVIDER=auto
# Optional. Blank uses each provider's default:
#   openai gpt-4.1-mini · anthropic claude-sonnet-5 · gemini gemini-3.6-flash
AI_MODEL=

# ─── Payments ──────────────────────────────────────────────────────────────
# demo | razorpay
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Payouts (RazorpayX) ───────────────────────────────────────────────────
# Capturing a payment only moves money as far as your own Razorpay account.
# A payout is what carries it to the recipient's bank or UPI. RazorpayX is a
# separate product: it needs its own activation, KYC, a funded account and IP
# allowlisting — so the default here is a simulator that behaves the same way
# without moving money. Set PAYOUTS_ENABLED=false to skip the last mile entirely
# and record a release without a payout, which is what demo mode does.
PAYOUTS_ENABLED=false
# simulated | upi-intent | razorpayx
# "upi-intent" moves REAL money: it generates an NPCI deep link the payer settles
# from their own bank app, then records the UTR. No licence, no fees, no custody.
# "simulated" runs the real payout state machine (queued -> processing ->
# processed, plus failures and reversals) without moving money or needing
# RazorpayX. Every payout it produces is labelled simulated in the interface.
PAYOUT_PROVIDER=simulated
# How long the simulated rail takes to settle, so "in flight" is visible.
PAYOUT_SIM_SETTLE_MS=8000
# The RazorpayX account number money is sent FROM (not the recipient's).
RAZORPAYX_ACCOUNT_NUMBER=
# Only needed if RazorpayX issues separate keys; otherwise the RAZORPAY_ ones are used.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# IMPS (instant, 24/7, up to Rs 5 lakh) | NEFT | RTGS. UPI destinations always use UPI.
PAYOUT_MODE=IMPS

# ─── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
